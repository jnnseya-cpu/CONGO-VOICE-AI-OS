# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in hours (default 336 = 14 days)
SESSION_TTL_HOURS=336
# Public origin, used for canonical URLs, the sitemap and social preview images
NEXT_PUBLIC_SITE_URL=https://congovoice.cd
DATA_DIR=./data
# PostgreSQL in production; leave empty to use the embedded database
DATABASE_URL=
CRON_SECRET=change-me
# 32 bytes, hex or base64. Encrypts second-factor seeds and stored recordings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Losing it makes existing recordings unreadable.
DATA_ENCRYPTION_KEY=
# Proxies in front of the app that are ours. The client address is read this many
# hops from the right of X-Forwarded-For; anything further left is caller-supplied.
TRUSTED_PROXY_HOPS=1
# Largest JSON body any route will read
MAX_JSON_BODY_BYTES=1048576

# ── AI providers (any subset; none = offline rules mode) ─────────────────────
ANTHROPIC_API_KEY=
# Alternative to ANTHROPIC_API_KEY when a gateway issues bearer tokens
ANTHROPIC_AUTH_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=
# Routing (internal keys, comma-separated): anthropic, gemini, openai, mock / google_tts
AI_LLM_ORDER=anthropic,gemini,openai,mock
AI_VISION_ORDER=anthropic,gemini,openai,mock
AI_STT_ORDER=openai,gemini,mock
AI_TTS_ORDER=google_tts,openai
AI_LLM_MODEL=claude-opus-5
AI_LLM_EFFORT=medium
GEMINI_MODEL=gemini-2.5-flash
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Override only for an OpenAI-compatible endpoint
OPENAI_BASE_URL=
AI_ALLOW_MOCK=true
AI_LOW_CONFIDENCE_THRESHOLD=0.55

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | gcs
GCS_BUCKET=
MAX_UPLOAD_BYTES=26214400

# ── Notifications ────────────────────────────────────────────────────────────
SMS_PROVIDER=log                # log | twilio | africastalking
WHATSAPP_PROVIDER=log           # log | twilio | meta
EMAIL_PROVIDER=log
ADMIN_ALERT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_AI_REQUESTS=30
RATE_LIMIT_MAX_AUTH_REQUESTS=10

# ── Sign-in protection ───────────────────────────────────────────────────────
# Failed attempts before an account or address is locked out
AUTH_MAX_FAILURES=5
# Lockout length in seconds, doubling for each further failed burst (max 24 h)
AUTH_LOCKOUT_SECONDS=900
# scrypt work factor for PIN hashing. Raise it, never lower it: existing PINs
# carry the cost they were created with and upgrade on next sign-in.
AUTH_SCRYPT_COST=131072
# PINs refused outright, comma-separated
AUTH_FORBIDDEN_PINS=0000,1111,1234,4321,123456,000000,111111,654321,112233,121212

# ── Demonstration data ───────────────────────────────────────────────────────
# The seed creates a platform administrator with a printed PIN, so it refuses to
# run when NODE_ENV=production. Both of these are needed to override that, and
# only ever on a staging environment mislabelled as production.
SEED_ALLOW_PRODUCTION=false
SEED_PIN=

# ── Channel layer ────────────────────────────────────────────────────────────
# Absolute base URL used in provider callbacks and media URLs (behind a proxy)
PUBLIC_BASE_URL=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
# Approved template used for proactive follow-ups outside the 24 h window
WHATSAPP_FOLLOW_UP_TEMPLATE=cvos_follow_up

# ── Notification policy ──────────────────────────────────────────────────────
NOTIFY_TZ_OFFSET_HOURS=1
NOTIFY_QUIET_START_HOUR=21
NOTIFY_QUIET_END_HOUR=6
NOTIFY_WEEKLY_CAP=3
NOTIFY_RETRY_ATTEMPTS=2
NOTIFY_RETRY_BACKOFF_MS=750
NOTIFY_DEDUPE_WINDOW_HOURS=24
VOICE_PROVIDER=log
