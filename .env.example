# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Which kind of deployment this is: dev, staging, pilot or prod. A stage that
# serves citizens (pilot, prod) must be able to reach a person, so the health
# probe fails there when no alert channel is configured.
DEPLOYMENT_STAGE=dev
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in hours (default 336 = 14 days)
SESSION_TTL_HOURS=336
# Public origin, used for canonical URLs, the sitemap and social preview images
NEXT_PUBLIC_SITE_URL=https://congovoicecd.com
DATA_DIR=./data
# PostgreSQL in production; leave empty to use the embedded database.
# Put no TLS parameters in it: pg assigns a parsed connection string over the
# config it is handed, so one sslmode= discards the CA below. They are stripped
# defensively, so an inherited URL that carries them still works.
DATABASE_URL=
# The PEM the database's certificate is verified against. A managed instance
# signs with a private per-instance CA, so nothing trusts it by default and
# without this the connection is encrypted but unauthenticated — which the
# platform says out loud rather than passing over. The chain is checked; the
# hostname is not, because the certificate names the instance while the
# connection is to its private address.
DATABASE_CA_CERT=
# Set to "disable" for a PostgreSQL that serves no certificate at all.
DATABASE_SSL=
# How long one AI provider may take before the gateway abandons it and tries the
# next in the chain. Not the limit on a conversation: the request ceiling is set
# to the platform's maximum so nothing external cuts a citizen off. This is what
# makes that safe — a vendor that accepts a connection and never answers would
# otherwise hold an instance for the whole hour. Defaults: 60s text, 90s audio
# upload, 45s speech synthesis.
AI_PROVIDER_TIMEOUT_MS=
# The request ceiling itself is not an application variable: it is set on the
# Cloud Run service and on the load balancer by scripts/go-live.sh and
# scripts/domain.sh (REQUEST_TIMEOUT and BACKEND_TIMEOUT, both 3600 by default).
CRON_SECRET=change-me
# Creates the FIRST platform administrator, once, through
# POST /api/v1/system/bootstrap. Without it that endpoint answers 404 and is
# indistinguishable from a path that does not exist. It is inert the moment an
# administrator exists — remove it from the deployment afterwards anyway.
BOOTSTRAP_TOKEN=
# How the maintenance endpoint recognises the platform's own scheduler when it
# calls with an identity token rather than a secret (Cloud Scheduler does this).
# Both must be set or the OIDC path is not offered at all — it never falls open.
# The audience is the exact URL the scheduler was configured to call.
CRON_OIDC_AUDIENCE=
CRON_SERVICE_ACCOUNT=

# ── Federated staff sign-in (IAM-002, SEC-02) ────────────────────────────────
# Leave empty to disable. A verified token proves identity, never entitlement:
# the subject must already be attached to a staff account created here, and the
# role always comes from that account.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Comma-separated; a token whose email is outside these domains is refused
OIDC_ALLOWED_DOMAINS=
# 32 bytes, hex or base64. Encrypts second-factor seeds and stored recordings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Losing it makes existing recordings unreadable.
DATA_ENCRYPTION_KEY=
# Proxies in front of the app that are ours. The client address is read this many
# hops from the right of X-Forwarded-For; anything further left is caller-supplied.
TRUSTED_PROXY_HOPS=1
# Largest JSON body any route will read
MAX_JSON_BODY_BYTES=1048576

# ── AI providers (any subset; none = offline rules mode) ─────────────────────
ANTHROPIC_API_KEY=
# Alternative to ANTHROPIC_API_KEY when a gateway issues bearer tokens
ANTHROPIC_AUTH_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=
# Routing (internal keys, comma-separated): anthropic, gemini, openai, mock / google_tts
AI_LLM_ORDER=anthropic,gemini,openai,mock
AI_VISION_ORDER=anthropic,gemini,openai,mock
AI_STT_ORDER=openai,gemini,mock
AI_TTS_ORDER=google_tts,openai
AI_LLM_MODEL=claude-opus-5
AI_LLM_EFFORT=medium
GEMINI_MODEL=gemini-2.5-flash
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# One voice of each gender (FR-LG-07)
OPENAI_TTS_VOICE=shimmer
OPENAI_TTS_VOICE_MALE=onyx
# Override only for an OpenAI-compatible endpoint
OPENAI_BASE_URL=
AI_ALLOW_MOCK=true
AI_LOW_CONFIDENCE_THRESHOLD=0.55
# A language answers freely only once its measured quality passes the §6.5 gates.
# Leave true: an unevaluated language then serves scripts and menus rather than
# fluent nonsense. Setting it false is a deliberate act for a supervised
# demonstration, and is recorded on every turn it affects.
LANGUAGE_GATES_ENFORCED=true
# How many low-confidence turns a reviewer is asked to look at each day (AI-16)
AI_REVIEW_SAMPLE_TARGET=100

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | gcs
GCS_BUCKET=
MAX_UPLOAD_BYTES=26214400

# ── Retention (SEC-06) ───────────────────────────────────────────────────────
# Raw voice is the most sensitive thing the platform holds; the structured
# record outlives it. Deletion is audited, and a file under legal hold is kept.
RETENTION_AUDIO_DAYS=90
RETENTION_IMAGE_DAYS=365
RETENTION_VIDEO_DAYS=365
RETENTION_DOCUMENT_DAYS=365

# ── Notifications ────────────────────────────────────────────────────────────
SMS_PROVIDER=log                # log | twilio | africastalking
WHATSAPP_PROVIDER=log           # log | twilio | meta
EMAIL_PROVIDER=log
# Where the platform sends operational alerts. It must be a mailbox somebody
# reads: an alert nobody receives is worse than none, because it looks handled.
ADMIN_ALERT_EMAIL=
# The one address the public site publishes. Defaults to contact@congovoicecd.com.
# Only set this to an address that receives mail — every page that offers a way
# to reach the programme uses it, including the data-rights and safety answers.
NEXT_PUBLIC_CONTACT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ── Tracing (NFR-O-01) ───────────────────────────────────────────────────────
# Leave empty to disable. One turn crosses the adapter, the orchestrator, the
# agents, the gateway and the database; a trace is the only thing that says
# which of them was slow.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=congo-voice-ai-os

# ── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_AI_REQUESTS=30
RATE_LIMIT_MAX_AUTH_REQUESTS=10

# ── Sign-in protection ───────────────────────────────────────────────────────
# Failed attempts before an account or address is locked out
AUTH_MAX_FAILURES=5
# Lockout length in seconds, doubling for each further failed burst (max 24 h)
AUTH_LOCKOUT_SECONDS=900
# scrypt work factor for PIN hashing. Raise it, never lower it: existing PINs
# carry the cost they were created with and upgrade on next sign-in.
AUTH_SCRYPT_COST=131072
# PINs refused outright, comma-separated
AUTH_FORBIDDEN_PINS=0000,1111,1234,4321,123456,000000,111111,654321,112233,121212

# ── Demonstration data ───────────────────────────────────────────────────────
# The seed creates a platform administrator with a printed PIN, so it refuses to
# run when NODE_ENV=production. Both of these are needed to override that, and
# only ever on a staging environment mislabelled as production.
SEED_ALLOW_PRODUCTION=false
SEED_PIN=

# ── Channel layer ────────────────────────────────────────────────────────────
# Absolute base URL used in provider callbacks and media URLs (behind a proxy)
PUBLIC_BASE_URL=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
# Approved template used for proactive follow-ups outside the 24 h window
WHATSAPP_FOLLOW_UP_TEMPLATE=cvos_follow_up

# ── Notification policy ──────────────────────────────────────────────────────
NOTIFY_TZ_OFFSET_HOURS=1
NOTIFY_QUIET_START_HOUR=21
NOTIFY_QUIET_END_HOUR=6
NOTIFY_WEEKLY_CAP=3
NOTIFY_RETRY_ATTEMPTS=2
NOTIFY_RETRY_BACKOFF_MS=750
NOTIFY_DEDUPE_WINDOW_HOURS=24
VOICE_PROVIDER=log
# Silence that ends a spoken turn on a call, in milliseconds, or "auto" to let the
# speech recogniser decide (FR-CH-03). Sent to the gateway rounded to whole seconds.
IVR_END_OF_UTTERANCE_MS=800

# ── Data residency ───────────────────────────────────────────────────────────
# Jurisdictions this deployment may send citizen data to (ISO 3166-1 alpha-2,
# comma-separated). A destination outside the list is never registered, so no
# ordering, retry or fallback can reach it. Empty means unrestricted, which is
# right on a laptop and is reported as a finding on a deployment that serves
# citizens. See docs/DATA_RESIDENCY.md for every destination and what it costs
# to refuse one.
#   DATA_RESIDENCY=CD           strictest: offline rules mode, nothing leaves
#   DATA_RESIDENCY=CD,ZA,US     the pilot posture while no DRC region exists
DATA_RESIDENCY=
# The country this deployment actually runs in. Declared, not guessed: a cloud
# region name is not a jurisdiction.
DEPLOYMENT_JURISDICTION=
# Where a self-hosted speech endpoint (OPENAI_BASE_URL) is operated. Undeclared
# is treated as forbidden under any policy.
AI_SELF_HOSTED_JURISDICTION=
# Override an operator's declared base when procurement establishes otherwise.
AFRICASTALKING_JURISDICTION=
